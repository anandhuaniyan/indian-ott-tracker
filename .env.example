# Required before production deployment
POSTGRES_USER=replace-with-database-user
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=ott_tracker
DATABASE_URL=postgresql+psycopg://replace-with-database-user:replace-with-database-password@postgres:5432/ott_tracker
REDIS_URL=redis://redis:6379/0
PGADMIN_DEFAULT_EMAIL=admin@example.invalid
PGADMIN_DEFAULT_PASSWORD=replace-with-a-different-long-random-password
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_SEARCH_DAILY_LIMIT=90
# Optional lawful IMDb-compatible ratings source. Current implementation supports an OMDb API account.
IMDB_RATING_PROVIDER=
IMDB_RATING_API_URL=https://www.omdbapi.com/
# Ordered, comma-separated OMDb key pool. Empty/duplicate entries are ignored.
# IMDB_RATING_API_KEY is used only when this pool is empty. Keys are never exposed to the frontend.
OMDB_API_KEYS=
IMDB_RATING_API_KEY=
# Scheduled OMDb IMDb-rating refresh is DISABLED by default while the AI/web
# research system is the rating source of truth. Set to true to re-enable the
# 6-hourly scheduled refresh (it will only process retryable rows, never touch
# AVAILABLE/NEEDS_REVIEW/PROVIDER_DATA_UNAVAILABLE states).
IMDB_RATING_REFRESH_ENABLED=false
METADATA_BACKFILL_BATCH_SIZE=100
PERSON_BACKFILL_BATCH_SIZE=100
IMAGE_BACKFILL_BATCH_SIZE=100
TRAILER_BACKFILL_BATCH_SIZE=50
IMDB_ID_BACKFILL_BATCH_SIZE=25
IMDB_BACKFILL_BATCH_SIZE=50
IMDB_BACKFILL_DELAY_SECONDS=0.1
OTT_BACKFILL_BATCH_SIZE=200
BACKFILL_MAX_ATTEMPTS=3
ON_DEMAND_REPAIR_COOLDOWN_HOURS=12
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_API_KEY=replace-with-a-long-random-admin-key
ADMIN_SESSION_SECRET=replace-with-a-different-long-random-secret
# Generate with: python -c "import hashlib,secrets; s=secrets.token_bytes(16); print('pbkdf2_sha256$310000$'+s.hex()+'$'+hashlib.pbkdf2_hmac('sha256',b'CHOOSE_PASSWORD',s,310000).hex())"
ADMIN_PASSWORD_HASH=
MEDIA_ROOT=media
REPORT_ISSUE_UPLOAD_ROOT=private_uploads/report_issues
FRONTEND_ORIGINS=http://localhost:5173
SITE_URL=http://localhost:5173
SITE_TIMEZONE=Asia/Singapore
MOVIE_DISCOVERY_REGULAR_PAST_DAYS=60
MOVIE_DISCOVERY_REGULAR_FUTURE_DAYS=180
MOVIE_DISCOVERY_WEEKLY_PAST_DAYS=365
MOVIE_DISCOVERY_WEEKLY_FUTURE_DAYS=365
MOVIE_DISCOVERY_MAX_PAGES_PER_LANGUAGE=50
SITE_CONTACT_EMAIL=otttrackerin@gmail.com
ADMIN_NOTIFICATION_EMAIL=otttrackerin@gmail.com
VITE_API_URL=
VITE_SITE_URL=http://localhost:5173
VITE_ENABLE_OTT_UPDATES=false
GOOGLE_SITE_VERIFICATION=
VITE_GOOGLE_SITE_VERIFICATION=
VITE_GA_MEASUREMENT_ID=
ADSENSE_PUBLISHER_ID=
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_ID=
OTT_RESEARCH_PROVIDER=
OTT_SEARCH_API_URL=
OTT_SEARCH_API_KEY=
# Optional Google Programmable Search JSON API credentials for lawful OTT evidence discovery.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
OTT_CONFIRMATION_THRESHOLD=85
OTT_RESEARCH_MIN_DAYS_AFTER_THEATRICAL_RELEASE=7
OTT_RESEARCH_HIGH_PRIORITY_DAYS=90
OTT_RESEARCH_MEDIUM_PRIORITY_DAYS=180
OTT_RESEARCH_AUTO_MAX_AGE_DAYS=365
OTT_DAILY_RESEARCH_MOVIE_LIMIT=20
# Optional lawful JSON adapters. The application never scrapes OTTplay or
# JustWatch; enable only when you control or are authorized to use the feed.
OTTPLAY_ENABLED=false
OTTPLAY_ADAPTER_URL=
OTTPLAY_API_KEY=
JUSTWATCH_ENABLED=false
JUSTWATCH_ADAPTER_URL=
JUSTWATCH_API_KEY=
OTT_SOURCE_SYNC_BATCH_SIZE=500
# Independent India availability providers. Keep disabled until the account's
# commercial-use, caching, attribution and region terms have been reviewed.
STREAMING_AVAILABILITY_ENABLED=false
STREAMING_AVAILABILITY_API_KEY=
STREAMING_AVAILABILITY_BASE_URL=https://api.movieofthenight.com/v4
STREAMING_AVAILABILITY_DAILY_LIMIT=100
STREAMING_AVAILABILITY_MONTHLY_LIMIT=1000
WATCHMODE_ENABLED=false
WATCHMODE_API_KEY=
WATCHMODE_BASE_URL=https://api.watchmode.com/v1
WATCHMODE_DAILY_LIMIT=100
WATCHMODE_MONTHLY_LIMIT=2500
TMDB_OTT_DAILY_LIMIT=1000
OTT_OBSERVATION_BATCH_SIZE=50
OTT_PROVIDER_FAILURE_THRESHOLD=3
OTT_PROVIDER_CIRCUIT_MINUTES=30
OTT_CACHE_UPCOMING_HOURS=12
OTT_CACHE_RECENT_HOURS=48
OTT_CACHE_HISTORICAL_DAYS=30
OTT_GOLD_SET_SIZE_PER_LANGUAGE=20
# Keep false until the manually verified 100-movie gold set passes the accuracy gate.
OTT_INTELLIGENCE_AUTO_PUBLICATION_ENABLED=false
# Free-only Tavily OTT evidence discovery. OTT_SEARCH_API_KEY remains supported
# for existing installations; TAVILY_API_KEY is preferred for new setups.
TAVILY_API_KEY=
TAVILY_MONTHLY_APP_BUDGET=800
# Hard ceiling, not a target. Early stopping typically uses fewer.
TAVILY_MAX_QUERIES_PER_MOVIE=3
# Provider-neutral, evidence-backed AI web research. Keep disabled until the
# bounded known-positive diagnostic has been reviewed.
AI_RESEARCH_ENABLED=false
AI_RESEARCH_PROVIDER=omniroute
AI_RESEARCH_MODEL=groq/openai/gpt-oss-20b
AI_RESEARCH_API_URL=http://host.docker.internal:20129/v1/research
AI_RESEARCH_API_KEY=
AI_RESEARCH_FALLBACK_PROVIDER=
AI_RESEARCH_FALLBACK_MODEL=
AI_RESEARCH_FALLBACK_API_URL=
AI_RESEARCH_FALLBACK_API_KEY=
AI_RESEARCH_MOVIES_PER_RUN=10
AI_RESEARCH_CALLS_PER_MOVIE=2
AI_RESEARCH_DAILY_CALL_LIMIT=20
AI_RESEARCH_CONCURRENCY=1
AI_RESEARCH_MAX_RETRIES=1
AI_RESEARCH_DISCORD_ENABLED=false
AI_RESEARCH_DISCORD_WEBHOOK_URL=
AI_RESEARCH_DISCORD_TIMEOUT_SECONDS=5
DISCORD_WEBHOOK_URL=
DISCORD_BOT_ENDPOINT=
DISCORD_BOT_SHARED_SECRET=
# Existing Discord bot adapter: implement /maintenance on|off|status by POSTing
# to /api/v1/maintenance/discord. These values are backend-only.
DISCORD_MAINTENANCE_SHARED_SECRET=
DISCORD_MAINTENANCE_ADMIN_IDS=
# Optional immutable guild restriction; blank permits any guild for allowlisted users.
DISCORD_MAINTENANCE_GUILD_ID=
# Cloudflare Worker Routes only. Never expose these values to Vite/frontend code.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_MAINTENANCE_WORKER=otttracker-maintenance
CLOUDFLARE_MAINTENANCE_ROUTES=otttracker.in/*,www.otttracker.in/*
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_ROUTE_TIMEOUT_SECONDS=10
CLOUDFLARE_MAINTENANCE_LOCK_SECONDS=30
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-email@gmail.com
SMTP_USE_TLS=true

# Private Support / Contributions (backend only; leave blank until configured)
PAYNOW_QR_URL=
PAYNOW_INSTRUCTIONS=
PAYNOW_RECIPIENT_LABEL=
SUPPORT_DISCORD_SHARED_SECRET=
SUPPORT_DISCORD_ADMIN_IDS=
SUPPORT_DISCORD_ADMIN_ROLE_IDS=

# Pinterest API (see https://developers.pinterest.com/apps/)
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:8000/api/v1/integrations/pinterest/callback
PINTEREST_ACCESS_TOKEN=
PINTEREST_REFRESH_TOKEN=
PINTEREST_ENABLED=false
