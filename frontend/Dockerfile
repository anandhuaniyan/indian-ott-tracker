FROM node:22-alpine AS build
WORKDIR /app
ARG VITE_API_URL=
ARG VITE_SITE_URL=http://localhost:5173
ARG VITE_SITE_CONTACT_EMAIL=
ARG VITE_GA_MEASUREMENT_ID=
ARG VITE_ADSENSE_CLIENT_ID=
ARG VITE_ADSENSE_SLOT_ID=
ARG VITE_GOOGLE_SITE_VERIFICATION=
ENV VITE_API_URL=$VITE_API_URL VITE_SITE_URL=$VITE_SITE_URL VITE_SITE_CONTACT_EMAIL=$VITE_SITE_CONTACT_EMAIL VITE_GA_MEASUREMENT_ID=$VITE_GA_MEASUREMENT_ID VITE_ADSENSE_CLIENT_ID=$VITE_ADSENSE_CLIENT_ID VITE_ADSENSE_SLOT_ID=$VITE_ADSENSE_SLOT_ID VITE_GOOGLE_SITE_VERIFICATION=$VITE_GOOGLE_SITE_VERIFICATION
COPY package.json ./
RUN npm install --omit=dev
COPY . .
RUN npm run build
FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
